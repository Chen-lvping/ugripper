# 可选 updater 包的职责是“在主包已完成数据盘挂载后，拉起 usb-auto-update@.service”。
# 主包 `config/99-fixed-usb-map.rules` 只负责允许 USB 口和挂载 `/mnt/data_disk`，
# 不再直接拉起 `usb-auto-update@<dev>.service`，这样未安装 updater 包时也不会出现
# 对缺失 unit 的隐式依赖。
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_BUS}=="usb", \
  ENV{ID_FS_USAGE}=="filesystem", KERNELS=="1-1", \
  ENV{SYSTEMD_WANTS}+="usb-auto-update@%k.service"
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", ENV{ID_BUS}=="usb", \
  ENV{ID_FS_USAGE}=="filesystem", KERNELS=="5-1", \
  ENV{SYSTEMD_WANTS}+="usb-auto-update@%k.service"
