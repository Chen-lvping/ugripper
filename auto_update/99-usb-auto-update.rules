# 可选 updater 包独立负责“USB 分区出现后挂载 /mnt/data_disk 并拉起 usb-auto-update@.service”。
# 主包不直接依赖 updater unit；未安装 updater 包时不会触发缺失 unit。
# 这里按 USB 父链路匹配，兼容部分 USB-SATA/UAS bridge 暴露成 ID_BUS=ata 的数据盘。
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", SUBSYSTEMS=="usb", \
  ENV{ID_FS_USAGE}=="filesystem", KERNELS=="1-1", \
  RUN+="/bin/sh -c '/usr/bin/systemd-run --no-block --collect --unit=ugripper-updater-data-mount-%k /usr/local/bin/ugripper_mount_data_disk.sh add \"$devnode\" \"$env{ID_FS_TYPE}\"'", \
  ENV{SYSTEMD_WANTS}+="usb-auto-update@%k.service"
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", SUBSYSTEMS=="usb", KERNELS=="1-1", \
  RUN+="/bin/sh -c '/usr/bin/systemd-run --no-block --collect --unit=ugripper-updater-data-umount-%k /usr/local/bin/ugripper_mount_data_disk.sh remove \"$devnode\"'"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", SUBSYSTEMS=="usb", \
  ENV{ID_FS_USAGE}=="filesystem", KERNELS=="5-1", \
