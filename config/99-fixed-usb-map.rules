  PROGRAM=="/bin/sh -c 'hub=/sys%p/../../../..; [ \"$$(cat $$hub/idVendor 2>/dev/null):$$(cat $$hub/idProduct 2>/dev/null)\" = \"05e3:0610\" ]'", \
