# Minimal fixed USB names for the current UGripper topology.
#
# Storage is handled by 99-usb-auto-update.rules. This file only maps:
# main cameras, chest camera, tactile cameras, Fays stereo/IMU, and CH9344.
#
# Board ports:
# - right USB2 hub: 1-1 or 5-1
# - right USB3 hub: 6-1 or 8-1
# - left USB2 hub: 9-1 or 11-1
# - left USB3 hub: 10-1 or 12-1
# - chest camera: 5-1 or 11-1 direct USB2 only
# - right upper USB(bus:5/6)
# - right lower USB(bus:1/8)
# - left upper USB(bus:9/10)
# - left lower USB(bus:11/12)

ACTION!="add|change", GOTO="ugripper_fixed_end"

SUBSYSTEM=="usb", GOTO="ugripper_fixed_usb"
SUBSYSTEM=="video4linux", GOTO="ugripper_fixed_video"
SUBSYSTEM=="tty", GOTO="ugripper_fixed_tty"
GOTO="ugripper_fixed_end"

LABEL="ugripper_fixed_usb"
# Fays SDK needs access to the USB device/control node. Match only SuperSpeed
# ports in the current UGripper side topology.
ENV{DEVTYPE}=="usb_device", KERNEL=="[68]-1", ATTR{idVendor}=="0403", ATTR{idProduct}=="602e", ATTR{speed}=="5000", MODE:="0777", GROUP:="plugdev"
ENV{DEVTYPE}=="usb_device", KERNEL=="[68]-1.[1-4]", ATTR{idVendor}=="0403", ATTR{idProduct}=="602e", ATTR{speed}=="5000", MODE:="0777", GROUP:="plugdev"
ENV{DEVTYPE}=="usb_device", KERNEL=="1[02]-1", ATTR{idVendor}=="0403", ATTR{idProduct}=="602e", ATTR{speed}=="5000", MODE:="0777", GROUP:="plugdev"
ENV{DEVTYPE}=="usb_device", KERNEL=="1[02]-1.[1-4]", ATTR{idVendor}=="0403", ATTR{idProduct}=="602e", ATTR{speed}=="5000", MODE:="0777", GROUP:="plugdev"
GOTO="ugripper_fixed_end"

LABEL="ugripper_fixed_video"
# Fays video + IMU streams on USB3. Interface 00 is stereo; interface 02 is IMU.
KERNEL=="video*", KERNELS=="[68]-1", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="00", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="stereo_right", SYMLINK+="right_fays_stereo"
KERNEL=="video*", KERNELS=="[68]-1.[1-4]", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="00", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="stereo_right", SYMLINK+="right_fays_stereo"
KERNEL=="video*", KERNELS=="[68]-1", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="02", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="right_fays_imu"
KERNEL=="video*", KERNELS=="[68]-1.[1-4]", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="02", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="right_fays_imu"
KERNEL=="video*", KERNELS=="1[02]-1", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="00", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="stereo_left", SYMLINK+="left_fays_stereo"
KERNEL=="video*", KERNELS=="1[02]-1.[1-4]", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="00", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="stereo_left", SYMLINK+="left_fays_stereo"
KERNEL=="video*", KERNELS=="1[02]-1", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="02", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="left_fays_imu"
KERNEL=="video*", KERNELS=="1[02]-1.[1-4]", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", ATTRS{speed}=="5000", ENV{ID_USB_INTERFACE_NUM}=="02", ATTR{index}=="0", MODE:="0777", GROUP:="video", SYMLINK+="left_fays_imu"

# Left/right main cameras on the hand USB2 hubs.
KERNEL=="video*", KERNELS=="[15]-1.4.4", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_right"
KERNEL=="video*", KERNELS=="[15]-1.1", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_right"
KERNEL=="video*", KERNELS=="[15]-1.2.1", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_right"
KERNEL=="video*", KERNELS=="[15]-1.7", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_right"
KERNEL=="video*", KERNELS=="9-1.4.[24]", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"
KERNEL=="video*", KERNELS=="11-1.4.[24]", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"
KERNEL=="video*", KERNELS=="9-1.1", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"
KERNEL=="video*", KERNELS=="11-1.1", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"
KERNEL=="video*", KERNELS=="9-1.2.1", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"
KERNEL=="video*", KERNELS=="11-1.2.1", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"
KERNEL=="video*", KERNELS=="9-1.7", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"
KERNEL=="video*", KERNELS=="11-1.7", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"

# Taobao commercial hub compatibility
KERNEL=="video*", KERNELS=="9-1.4", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_left"
KERNEL=="video*", KERNELS=="1-1.4", ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="cam_right"

# Chest camera can only be directly plugged into right-upper or left-lower USB2.
KERNEL=="video*", KERNELS=="5-1:1.0", ENV{ID_VENDOR_ID}=="27c2", ENV{ID_MODEL_ID}=="0530", ATTR{index}=="0", SYMLINK+="cam_chest"
KERNEL=="video*", KERNELS=="11-1:1.0", ENV{ID_VENDOR_ID}=="27c2", ENV{ID_MODEL_ID}=="0530", ATTR{index}=="0", SYMLINK+="cam_chest"

# Tactile cameras on the hand USB2 hubs.
KERNEL=="video*", KERNELS=="[15]-1.4.2", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_l"
KERNEL=="video*", KERNELS=="[15]-1.3", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_l"
KERNEL=="video*", KERNELS=="[15]-1.4.1", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_r"
KERNEL=="video*", KERNELS=="[15]-1.4:1.0", ENV{ID_VENDOR_ID}=="0bda", ENV{ID_MODEL_ID}=="5846", ATTR{index}=="0", SYMLINK+="tcam_right_r"
KERNEL=="video*", KERNELS=="[15]-1.5", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_r"
KERNEL=="video*", KERNELS=="[15]-1.2", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_r"
KERNEL=="video*", KERNELS=="9-1.4.[24]", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_l"
KERNEL=="video*", KERNELS=="11-1.4.[24]", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_l"
KERNEL=="video*", KERNELS=="9-1.3", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_l"
KERNEL=="video*", KERNELS=="11-1.3", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_l"
KERNEL=="video*", KERNELS=="9-1.4.1", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_r"
KERNEL=="video*", KERNELS=="11-1.4.1", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_r"
KERNEL=="video*", KERNELS=="9-1.4:1.0", ENV{ID_VENDOR_ID}=="0bda", ENV{ID_MODEL_ID}=="5846", ATTR{index}=="0", SYMLINK+="tcam_left_r"
KERNEL=="video*", KERNELS=="11-1.4:1.0", ENV{ID_VENDOR_ID}=="0bda", ENV{ID_MODEL_ID}=="5846", ATTR{index}=="0", SYMLINK+="tcam_left_r"
KERNEL=="video*", KERNELS=="9-1.5", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_r"
KERNEL=="video*", KERNELS=="11-1.5", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_r"
KERNEL=="video*", KERNELS=="9-1.2", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_r"
KERNEL=="video*", KERNELS=="11-1.2", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_r"

# Taobao commercial hub compatibility
KERNEL=="video*", KERNELS=="1-1.2.3", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_l"
KERNEL=="video*", KERNELS=="1-1.2.4", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_right_r"
KERNEL=="video*", KERNELS=="9-1.2.3", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_l"
KERNEL=="video*", KERNELS=="9-1.2.4", ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTRS{speed}=="480", ATTR{index}=="0", SYMLINK+="tcam_left_r"
GOTO="ugripper_fixed_end"

LABEL="ugripper_fixed_tty"
# CH9344 exposes multiple tty nodes without a stable per-port sysfs attribute.
# Keep udev rules thin: one permission rule, then a small helper returns the
# symlink name for group rank 1/2 only (gripper/encoder). The helper accepts
# legacy/nested hub ports 1/2 and the four-port hand hub's port 4.
KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", MODE:="0666"
KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", PROGRAM=="/usr/local/bin/ugripper_ch9344_symlink_name %p %k", SYMLINK+="%c"

LABEL="ugripper_fixed_end"
