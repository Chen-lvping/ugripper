# 热插拔兜底：部分 USB bridge / hub 断链时，按物理口匹配的 partition remove 事件可能不完整。
# 这里对任意 USB block remove 再补一次清理触发，真正是否卸载仍由 mount_data_disk.sh
# 基于当前挂载源、设备节点是否存在、挂载是否已变成 stale/只读来判断。
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", SUBSYSTEMS=="usb", \
  RUN+="/bin/sh -c '/usr/bin/systemd-run --no-block --collect --unit=ugripper-data-umount-fallback-%k /opt/ugripper/auto_update/mount_data_disk.sh remove \"$devnode\"'"
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", SUBSYSTEMS=="usb", \
  RUN+="/bin/sh -c '/usr/bin/systemd-run --no-block --collect --unit=ugripper-data-umount-fallback-%k /opt/ugripper/auto_update/mount_data_disk.sh remove \"$devnode\"'"
