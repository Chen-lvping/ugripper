# ---- Right main camera (YuZhuo USB FHD Camera, 27c2:0530) ----
# 右主摄 packet size helper 仍在包内保留，但自动触发尚未调通，暂不由 udev 执行。
# 这里仅保留固定节点映射和权限。
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNELS=="1-1.4.4", \
  ATTR{idVendor}=="27c2", ATTR{idProduct}=="0530", MODE:="0666", GROUP:="plugdev", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNELS=="5-1.4.4", \
  ATTR{idVendor}=="27c2", ATTR{idProduct}=="0530", MODE:="0666", GROUP:="plugdev", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNELS=="1-1.1", \
  ATTR{idVendor}=="27c2", ATTR{idProduct}=="0530", MODE:="0666", GROUP:="plugdev", TAG+="uaccess"
ACTION=="add|change", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", KERNELS=="5-1.1", \
  ATTR{idVendor}=="27c2", ATTR{idProduct}=="0530", MODE:="0666", GROUP:="plugdev", TAG+="uaccess"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="1-1.4.4", \
  ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTR{index}=="0", MODE:="0660", GROUP:="video", TAG+="uaccess", \
  SYMLINK+="cam_right"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="5-1.4.4", \
  ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTR{index}=="0", MODE:="0660", GROUP:="video", TAG+="uaccess", \
  SYMLINK+="cam_right"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="1-1.1", \
  ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTR{index}=="0", MODE:="0660", GROUP:="video", TAG+="uaccess", \
  PROGRAM=="/bin/sh -c 'hub=/sys%p/../../../..; [ \"$$(cat $$hub/idVendor 2>/dev/null):$$(cat $$hub/idProduct 2>/dev/null)\" = \"1a86:80a0\" ]'", \
  SYMLINK+="cam_right"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="5-1.1", \
  ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTR{index}=="0", MODE:="0660", GROUP:="video", TAG+="uaccess", \
