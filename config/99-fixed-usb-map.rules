# ========================
# 2. USB multi-serial bridges
# ========================
# v2 编码器现通过 QinHeng CH9344 多串口桥暴露为 /dev/ttyCH9344USB*。
# 这里统一放开 tty 节点权限，便于现场脚本直接探测；不绑定固定端口号。
SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9",   MODE:="0666", TAG+="uaccess"

# CH9344 gripper HMI 固定口映射：旧 hub 只依赖左右 USB2 hub 路径 + 同组 tty 的内核顺序，
# 不依赖全局 ttyCH9344USB<num> 号。允许同侧 USB2 hub 的内部端口 .1/.2 互换。
# 在同一个 CH9344 设备组下，组内排序第 1 路 = gripper HMI，第 2 路 = encoder。
# 新版不再接板载 IM648，因此不生成 left_imu / right_imu。
# 通过 PROGRAM 的退出码判断“当前 tty 是否为组内第 N 路”，不依赖额外 role probe。
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="1-1.1",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 1p); [ %k = $$pick ]'", SYMLINK+="right_gripper"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="1-1.2",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 1p); [ %k = $$pick ]'", SYMLINK+="right_gripper"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="5-1.1",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 1p); [ %k = $$pick ]'", SYMLINK+="right_gripper"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="5-1.2",   PROGRAM=="/bin/sh -c 'hub=/sys%p/../../../..; [ \"$$(cat $$hub/idVendor 2>/dev/null):$$(cat $$hub/idProduct 2>/dev/null)\" = \"1a86:80a0\" ] || exit 1; pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 1p); [ %k = $$pick ]'", SYMLINK+="right_gripper"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="9-1.1",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 1p); [ %k = $$pick ]'", SYMLINK+="left_gripper"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="9-1.2",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 1p); [ %k = $$pick ]'", SYMLINK+="left_gripper"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="11-1.1",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 1p); [ %k = $$pick ]'", SYMLINK+="left_gripper"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="11-1.2",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 1p); [ %k = $$pick ]'", SYMLINK+="left_gripper"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="1-1.1",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 2p); [ %k = $$pick ]'", SYMLINK+="right_encoder"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="1-1.2",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 2p); [ %k = $$pick ]'", SYMLINK+="right_encoder"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="5-1.1",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 2p); [ %k = $$pick ]'", SYMLINK+="right_encoder"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="5-1.2",   PROGRAM=="/bin/sh -c 'hub=/sys%p/../../../..; [ \"$$(cat $$hub/idVendor 2>/dev/null):$$(cat $$hub/idProduct 2>/dev/null)\" = \"1a86:80a0\" ] || exit 1; pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 2p); [ %k = $$pick ]'", SYMLINK+="right_encoder"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="9-1.1",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 2p); [ %k = $$pick ]'", SYMLINK+="left_encoder"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="9-1.2",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 2p); [ %k = $$pick ]'", SYMLINK+="left_encoder"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="11-1.1",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 2p); [ %k = $$pick ]'", SYMLINK+="left_encoder"
ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="11-1.2",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 2p); [ %k = $$pick ]'", SYMLINK+="left_encoder"
# ========================
# 3. USB audio headset
# ========================
# v2 音频优先使用受支持的外接 USB 耳机；当前兼容两款 liyuany 设备：
# - USB Audio             (0020:0b21)
# - USB PnP Sound Device  (0023:0b23)
# 这里按设备指纹匹配，不绑定具体物理口；插在板载 4 个 USB 口任意一个都能识别。
SUBSYSTEM=="usb", ATTR{idVendor}=="0020", ATTR{idProduct}=="0b21",   MODE:="0666", TAG+="uaccess"
SUBSYSTEM=="sound", KERNEL=="card*", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_card"
SUBSYSTEM=="sound", KERNEL=="controlC*", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_control"
SUBSYSTEM=="sound", KERNEL=="pcmC*D*p", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_playback"
SUBSYSTEM=="sound", KERNEL=="pcmC*D*c", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_capture"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21", MODE:="0666", SYMLINK+="input/ugripper_usb_audio_keys"
SUBSYSTEM=="usb", ATTR{idVendor}=="0023", ATTR{idProduct}=="0b23",   MODE:="0666", TAG+="uaccess"
SUBSYSTEM=="sound", KERNEL=="card*", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_card"
SUBSYSTEM=="sound", KERNEL=="controlC*", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_control"
SUBSYSTEM=="sound", KERNEL=="pcmC*D*p", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_playback"
SUBSYSTEM=="sound", KERNEL=="pcmC*D*c", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_capture"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23", MODE:="0666", SYMLINK+="input/ugripper_usb_audio_keys"

# ========================
# 4. Storage devices
# ========================
# 数据盘挂载/卸载和 USB 升级触发由独立 das-usb-updater 包的
# 99-usb-auto-update.rules 承载；主包只保留传感器、串口和音频映射。
