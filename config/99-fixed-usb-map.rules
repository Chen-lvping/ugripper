# ========================
# RK3588 USB sensor groups
# ========================
# 命名约定：
# - 右侧 hub 可插右上 / 右下物理口：USB2=5-1|1-1，USB3=6-1|8-1
# - 左侧 hub 可插左上 / 左下物理口：USB2=9-1|11-1，USB3=10-1|12-1
# - 右侧 hub 内部端口约定：
#   * .4.1 -> tcam_r
#   * .4.2 -> tcam_l
#   * .4.4 -> cam_main (YuZhuo, 27c2:0530)
# - 新 hub (`1a86:80a0`/`1a86:80a1`) 内部端口约定：
#   * USB2 .1 -> cam_main (YuZhuo, 27c2:0530)
#   * 右侧 USB2 .3 -> tcam_l (0bda:5846)
#   * 右侧 USB2 .4 -> tcam_r (0bda:5846)
#   * 左侧 USB2 .3 -> tcam_l (0bda:5846)
#   * 左侧 USB2 .4 -> tcam_r (0bda:5846)
#   * USB3 .3/.4 -> Fays stereo (0403:602e)
# - 部分左手旧特殊 hub (`05e3:0610` + 下游 `214b:7260`) 会把 tcam_r 放在 USB2 .3。
# - 左侧更换新 hub 后，主摄 / tactile 的内部端口与右侧保持同构；仅主摄仍保留设备类型优先兜底：
#   * tactile `l/r` 仍按左右侧固定节点命名，不做跨侧互换
#   * 左侧主摄 / tactile `l` 优先按设备类型识别（27c2:0530 = main, 0bda:5846 = tactile），
#     USB2 口位只用于限定“属于左侧链路”，不再假设固定落在 .4.2 / .4.4
#   * 左侧 tactile `r` 同时兼容旧 hub 的 `.4.1` 和新 hub 的 `.4`
#   * Fays stereo 使用 USB3 路径；旧 hub 允许 `.1/.2` 互换，新 hub `1a86:80a1` 兼容 `.3/.4`
# 摄像头通常会生成两个节点 (videoN, videoN+1)，这里只取 index=0 的主节点。

# ========================
# 1. USB cameras
# ========================
# ---- Right tactile cameras ----
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="1-1.4.2", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTR{index}=="0", \
  SYMLINK+="tcam_right_l"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="5-1.4.2", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTR{index}=="0", \
  SYMLINK+="tcam_right_l"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="1-1.3", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTR{index}=="0", \
  PROGRAM=="/bin/sh -c 'hub=/sys%p/../../../..; [ \"$$(cat $$hub/idVendor 2>/dev/null):$$(cat $$hub/idProduct 2>/dev/null)\" = \"1a86:80a0\" ]'", \
  SYMLINK+="tcam_right_l"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="5-1.3", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTR{index}=="0", \
  PROGRAM=="/bin/sh -c 'hub=/sys%p/../../../..; [ \"$$(cat $$hub/idVendor 2>/dev/null):$$(cat $$hub/idProduct 2>/dev/null)\" = \"1a86:80a0\" ]'", \
  SYMLINK+="tcam_right_l"

SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="1-1.4.1", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTR{index}=="0", \
  SYMLINK+="tcam_right_r"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="5-1.4.1", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5846", ATTR{index}=="0", \
  SYMLINK+="tcam_right_r"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="1-1.4:1.0", \
  ENV{ID_VENDOR_ID}=="0bda", ENV{ID_MODEL_ID}=="5846", ATTR{index}=="0", \
  PROGRAM=="/bin/sh -c 'hub=/sys%p/../../../..; [ \"$$(cat $$hub/idVendor 2>/dev/null):$$(cat $$hub/idProduct 2>/dev/null)\" = \"1a86:80a0\" ]'", \
  SYMLINK+="tcam_right_r"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="5-1.4:1.0", \
  ENV{ID_VENDOR_ID}=="0bda", ENV{ID_MODEL_ID}=="5846", ATTR{index}=="0", \
  PROGRAM=="/bin/sh -c 'hub=/sys%p/../../../..; [ \"$$(cat $$hub/idVendor 2>/dev/null):$$(cat $$hub/idProduct 2>/dev/null)\" = \"1a86:80a0\" ]'", \
  SYMLINK+="tcam_right_r"

