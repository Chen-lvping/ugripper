ACTION=="add", SUBSYSTEM=="tty", KERNEL=="ttyCH9344USB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d9", KERNELS=="11-1.2",   PROGRAM=="/bin/sh -c 'pick=$$(for node in /sys%p/../ttyCH9344USB*; do basename $$node; done | sort -V | sed -n 3p); [ %k = $$pick ]'", SYMLINK+="left_imu"

# ========================
# 3. USB audio headset
# ========================
# v2 音频优先使用受支持的外接 USB 耳机；当前兼容两款 liyuany 设备：
# - USB Audio             (0020:0b21)
# - USB PnP Sound Device  (0023:0b23)
# 这里按设备指纹匹配，不绑定具体物理口；插在板载 4 个 USB 口任意一个都能识别。
SUBSYSTEM=="usb", ATTR{idVendor}=="0020", ATTR{idProduct}=="0b21",   MODE:="0666", TAG+="uaccess"
SUBSYSTEM=="sound", KERNEL=="card*", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_card"
SUBSYSTEM=="sound", KERNEL=="controlC*", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_control"
SUBSYSTEM=="sound", KERNEL=="pcmC*D*p", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_playback"
SUBSYSTEM=="sound", KERNEL=="pcmC*D*c", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_capture"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="0020", ATTRS{idProduct}=="0b21", MODE:="0666", SYMLINK+="input/ugripper_usb_audio_keys"
SUBSYSTEM=="usb", ATTR{idVendor}=="0023", ATTR{idProduct}=="0b23",   MODE:="0666", TAG+="uaccess"
SUBSYSTEM=="sound", KERNEL=="card*", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_card"
SUBSYSTEM=="sound", KERNEL=="controlC*", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_control"
SUBSYSTEM=="sound", KERNEL=="pcmC*D*p", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_playback"
SUBSYSTEM=="sound", KERNEL=="pcmC*D*c", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23",   MODE:="0666", GROUP:="audio", SYMLINK+="snd/ugripper_usb_audio_capture"
SUBSYSTEM=="input", KERNEL=="event*", ATTRS{idVendor}=="0023", ATTRS{idProduct}=="0b23", MODE:="0666", SYMLINK+="input/ugripper_usb_audio_keys"

# ========================
# 2. Storage devices
# ========================
# 数据盘允许插在四个物理 USB 口中的任意一个；按物理口祖先 KERNELS 匹配，避免依赖漂移的 /dev/sdX。
# 对经 USB-SATA/UAS bridge 暴露成 ID_BUS=ata 的设备，仍按 USB 父链路匹配，否则抖动重枚举后可能只剩桌面自动挂载。
# exfat 由主包安装时自动配置为开机提前加载。
# 挂载/卸载由 root helper 在独立 systemd-run 任务里执行，避免在 udev worker 内直接做 mount。
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", SUBSYSTEMS=="usb", \
  ENV{ID_FS_USAGE}=="filesystem", KERNELS=="1-1", \
  RUN+="/bin/sh -c '/usr/bin/systemd-run --no-block --collect --unit=ugripper-data-mount-%k /opt/ugripper/auto_update/mount_data_disk.sh add \"$devnode\" \"$env{ID_FS_TYPE}\"'", \
  ENV{SYSTEMD_WANTS}+="usb-auto-update@%k.service"
ACTION=="remove", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", SUBSYSTEMS=="usb", KERNELS=="1-1", \
  RUN+="/bin/sh -c '/usr/bin/systemd-run --no-block --collect --unit=ugripper-data-umount-%k /opt/ugripper/auto_update/mount_data_disk.sh remove \"$devnode\"'"
