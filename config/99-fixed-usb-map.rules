SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="11-1.4.2", \
  ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTR{index}=="0", MODE:="0660", GROUP:="video", TAG+="uaccess", \
  SYMLINK+="left_cam_main"
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="11-1.4.4", \
  ATTRS{idVendor}=="27c2", ATTRS{idProduct}=="0530", ATTR{index}=="0", MODE:="0660", GROUP:="video", TAG+="uaccess", \
  SYMLINK+="left_cam_main"
ACTION=="add", SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="9-1.4.2", \
