#!/bin/bash
set -e

SERVICE_NAME="{{APP_NAME}}.service"
INTERFACE_NAME="end0"
NM_CONN_ID="${INTERFACE_NAME}-{{APP_NAME}}"

# 定义所有涉及的服务名称
PTP_SERVICE="ptp4l.service"
PHC_SERVICE="phc2sys.service"
MONITOR_SERVICE="ugripper-ptp-monitor.service"
NTP_SYNC_SERVICE="ugripper-ntp-sync.service"
NETWORK_MONITOR_SERVICE="ugripper-network-monitor.service"
SHUTDOWN_TRIGGER_SERVICE="umi-shutdown-trigger.service"
SHUTDOWN_TRIGGER_PATH="umi-shutdown-trigger.path"

stop_service_fast() {
    local service_name="$1"
    local timeout_sec="${2:-5}"

    timeout "${timeout_sec}s" systemctl stop "$service_name" >/dev/null 2>&1 || true

    if systemctl is-active --quiet "$service_name"; then
        echo "Warning: $service_name stop timeout, force killing..."
        systemctl kill "$service_name" >/dev/null 2>&1 || true
    fi
}

force_cleanup_recording_processes() {
    if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -f '/opt/ugripper/run_record.sh' >/dev/null 2>&1 || true
        pkill -TERM -f 'led_manager.py' >/dev/null 2>&1 || true
        pkill -TERM -f 'audio/audio_play.py' >/dev/null 2>&1 || true
        sleep 0.3
        pkill -KILL -f '/opt/ugripper/run_record.sh' >/dev/null 2>&1 || true
        pkill -KILL -f 'led_manager.py' >/dev/null 2>&1 || true
        pkill -KILL -f 'audio/audio_play.py' >/dev/null 2>&1 || true
    fi

    rm -f /tmp/umi_audio_pipe /tmp/umi_led_pipe /tmp/umi_recording.lock || true
}

echo "Removing {{APP_NAME}} configuration..."

# --------------------------------------------------
# 1) 快速停止服务与残留进程（避免安装后旧进程残留）
# --------------------------------------------------
stop_service_fast "$SERVICE_NAME" 6
stop_service_fast "$NETWORK_MONITOR_SERVICE" 4
stop_service_fast "$MONITOR_SERVICE" 4
stop_service_fast "$NTP_SYNC_SERVICE" 4
stop_service_fast "$PHC_SERVICE" 4
stop_service_fast "$PTP_SERVICE" 4
force_cleanup_recording_processes

# --------------------------------------------------
# 2) 禁用服务
# --------------------------------------------------
systemctl disable "$SERVICE_NAME" || true
systemctl disable "$NETWORK_MONITOR_SERVICE" || true
systemctl disable "$SHUTDOWN_TRIGGER_PATH" || true
systemctl disable "$SHUTDOWN_TRIGGER_SERVICE" || true
systemctl disable "$NTP_SYNC_SERVICE" || true
systemctl disable "$MONITOR_SERVICE" || true
systemctl disable "$PHC_SERVICE" || true
systemctl disable "$PTP_SERVICE" || true

# --------------------------------------------------
# 3) 清理生成的文件
# --------------------------------------------------
echo "Cleaning up systemd units and configs..."

# 清理 postinst 中生成的 systemd unit 文件
rm -f "/etc/systemd/system/$PHC_SERVICE"
rm -f "/etc/systemd/system/$PTP_SERVICE"
rm -f "/etc/systemd/system/$SHUTDOWN_TRIGGER_SERVICE"
rm -f "/etc/systemd/system/$SHUTDOWN_TRIGGER_PATH"

# 清理生成的配置文件
rm -f "/etc/linuxptp/ptp4l.conf"

# 清理共享内存中的临时状态文件 (PTP Monitor 产生的)
rm -f "/dev/shm/umi_ptp_status"

# --------------------------------------------------
# 4) 移除网络配置
# --------------------------------------------------
if command -v nmcli >/dev/null 2>&1; then
    nmcli connection delete "$NM_CONN_ID" || true
fi

# --------------------------------------------------
# 5) 恢复系统默认行为
# --------------------------------------------------
echo "Restoring default NTP behavior..."
systemd-run --no-block --unit=ugripper-restore-ntp \
    /usr/bin/timedatectl set-ntp true

systemctl daemon-reload

# --------------------------------------------------
# 6) udev reload
# --------------------------------------------------
udevadm control --reload-rules || true

echo "{{APP_NAME}} cleanup finished."
exit 0
