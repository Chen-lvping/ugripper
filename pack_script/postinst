#!/bin/bash
set -e

APP_DIR="{{INSTALL_DIR}}"
SERVICE_NAME="{{APP_NAME}}.service"

SHUTDOWN_TRIGGER_SCRIPT="${APP_DIR}/auto_update/trigger_shutdown.sh"
SHUTDOWN_TRIGGER_SERVICE="umi-shutdown-trigger.service"
SHUTDOWN_TRIGGER_PATH="umi-shutdown-trigger.path"
NETWORK_MONITOR_SERVICE="ugripper-network-monitor.service"
CALIB_PERSIST_DIR="/etc/ugripper/config/calibration"
CALIB_PERSIST_FILE="${CALIB_PERSIST_DIR}/calibration.json"
DATA_MOUNT_POINT="/mnt/data_disk"

stop_service_fast() {
    local service_name="$1"
    local timeout_sec="${2:-6}"

    timeout "${timeout_sec}s" systemctl stop "$service_name" >/dev/null 2>&1 || true

    if systemctl is-active --quiet "$service_name"; then
        echo "Warning: $service_name stop timeout, force killing..."
        systemctl kill "$service_name" >/dev/null 2>&1 || true
    fi
}

force_cleanup_recording_processes() {
    if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -f '/opt/ugripper/run_record.sh' >/dev/null 2>&1 || true
        pkill -TERM -f 'gripper_hmi_test.*--state' >/dev/null 2>&1 || true
        pkill -TERM -f 'audio/audio_play.py' >/dev/null 2>&1 || true
        sleep 0.3
        pkill -KILL -f '/opt/ugripper/run_record.sh' >/dev/null 2>&1 || true
        pkill -KILL -f 'gripper_hmi_test.*--state' >/dev/null 2>&1 || true
        pkill -KILL -f 'audio/audio_play.py' >/dev/null 2>&1 || true
    fi

    rm -f /tmp/umi_audio_pipe /tmp/umi_recording.lock || true
}

calibration_file_is_valid() {
    local path="$1"

    [ -s "$path" ] || return 1

    if ! command -v python3 >/dev/null 2>&1; then
        return 0
    fi

    python3 - "$path" <<'PY' >/dev/null 2>&1
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
data = json.loads(path.read_text(encoding="utf-8"))
sys.exit(0 if isinstance(data, dict) else 1)
PY
}

ensure_persist_calibration() {
    local fallback_file="$APP_DIR/config/fakeCamCalib.json"

    [ -f "$fallback_file" ] || return 0

    if calibration_file_is_valid "$CALIB_PERSIST_FILE"; then
        return 0
    fi

    cp -f "$fallback_file" "$CALIB_PERSIST_FILE"
}

# 安装窗口先清理旧业务进程，避免升级后残留占用音频/GPIO/FIFO
stop_service_fast "$SERVICE_NAME" 6
stop_service_fast "$NETWORK_MONITOR_SERVICE" 4
force_cleanup_recording_processes

# --------------------------------------------------
# 0) 单机双手模式：停用旧双机 DEVICE_SIDE/PTP 配置
# --------------------------------------------------

# 主包不再托管有线静态 IP，沿用系统现有 NetworkManager 配置。

# --------------------------------------------------
# 3) 配置应用服务权限及启动
# --------------------------------------------------
chmod +x "$APP_DIR/run_record.sh"
chmod +x "$SHUTDOWN_TRIGGER_SCRIPT"
chmod -R 777 "$APP_DIR"

# 初始化持久化标定目录：缺失、空文件或非法 JSON 时写入默认 fake calibration
mkdir -p "$CALIB_PERSIST_DIR"
ensure_persist_calibration

# 固定数据盘挂载点：默认存在但不可作为本地数据目录误用
mkdir -p "$DATA_MOUNT_POINT"
chown root:root "$DATA_MOUNT_POINT" >/dev/null 2>&1 || true
chmod 0555 "$DATA_MOUNT_POINT" >/dev/null 2>&1 || true

systemctl daemon-reload

udevadm control --reload-rules
# 仅重触发视频/声音设备，应用相机与 USB 音频相关 udev 规则；避免触发 block add 导致升级期间重复执行 usb-auto-update
udevadm trigger --subsystem-match=video4linux
udevadm trigger --subsystem-match=sound
udevadm trigger --subsystem-match=input
# 不主动触发 block add，存储设备规则等待后续真实插拔事件生效

# 双键关机触发服务
# 安装阶段若残留触发文件，会导致 Path 单元立即触发关机流程。先清理。
rm -f /tmp/umi_shutdown_request
systemctl enable "$SHUTDOWN_TRIGGER_SERVICE" "$SHUTDOWN_TRIGGER_PATH"
if ! systemctl restart "$SHUTDOWN_TRIGGER_PATH"; then
    echo "Warning: failed to restart $SHUTDOWN_TRIGGER_PATH (will not block install)"
fi

# 主应用服务
systemctl enable "$SERVICE_NAME"
systemctl restart "$SERVICE_NAME"

# 网线监测服务最后启动，降低安装窗口内竞态
systemctl enable "$NETWORK_MONITOR_SERVICE"
systemctl restart "$NETWORK_MONITOR_SERVICE"

echo "[$SERVICE_NAME] Installed and Started successfully."
exit 0
