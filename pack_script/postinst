#!/bin/bash
set -e

APP_DIR="{{INSTALL_DIR}}"
SERVICE_NAME="{{APP_NAME}}.service"

INTERFACE_NAME="end0"
IP_RIGHT="192.168.1.100"
IP_LEFT="192.168.1.101"

# PTP 配置目录和文件
PTP_CONF_DIR="/etc/linuxptp"
PTP_CONF_FILE="${PTP_CONF_DIR}/ptp4l.conf"

# PTP 监控脚本路径
MONITOR_SCRIPT="${APP_DIR}/time_sync/ptp_monitor.sh"
MONITOR_SERVICE="ugripper-ptp-monitor.service"

# NTP 同步服务路径
NTP_SYNC_SCRIPT="${APP_DIR}/time_sync/safe_ntp_sync.sh"
NTP_SYNC_SERVICE="ugripper-ntp-sync.service"
SHUTDOWN_TRIGGER_SCRIPT="${APP_DIR}/auto_update/trigger_shutdown.sh"
SHUTDOWN_TRIGGER_SERVICE="umi-shutdown-trigger.service"
SHUTDOWN_TRIGGER_PATH="umi-shutdown-trigger.path"
NETWORK_MONITOR_SERVICE="ugripper-network-monitor.service"
CALIB_PERSIST_DIR="/etc/ugripper/config/calibration"
CALIB_PERSIST_FILE="${CALIB_PERSIST_DIR}/calibration.json"

stop_service_fast() {
    local service_name="$1"
    local timeout_sec="${2:-6}"

    timeout "${timeout_sec}s" systemctl stop "$service_name" >/dev/null 2>&1 || true

    if systemctl is-active --quiet "$service_name"; then
        echo "Warning: $service_name stop timeout, force killing..."
        systemctl kill "$service_name" >/dev/null 2>&1 || true
    fi
}

force_cleanup_recording_processes() {
    if command -v pkill >/dev/null 2>&1; then
        pkill -TERM -f '/opt/ugripper/run_record.sh' >/dev/null 2>&1 || true
        pkill -TERM -f 'led_manager.py' >/dev/null 2>&1 || true
        pkill -TERM -f 'audio/audio_play.py' >/dev/null 2>&1 || true
        sleep 0.3
        pkill -KILL -f '/opt/ugripper/run_record.sh' >/dev/null 2>&1 || true
        pkill -KILL -f 'led_manager.py' >/dev/null 2>&1 || true
        pkill -KILL -f 'audio/audio_play.py' >/dev/null 2>&1 || true
    fi

    rm -f /tmp/umi_audio_pipe /tmp/umi_led_pipe /tmp/umi_recording.lock || true
}

restart_ptp_stack_with_retry() {
    local max_retry=3
    local i

    echo "Starting PTP services..."
    systemctl enable ptp4l phc2sys || true

    for i in $(seq 1 "$max_retry"); do
        systemctl restart ptp4l phc2sys || true
        sleep 1

        if systemctl is-active --quiet ptp4l && systemctl is-active --quiet phc2sys; then
            echo "PTP services active (attempt $i/$max_retry)."
            return 0
        fi

        echo "Warning: PTP services not ready (attempt $i/$max_retry)."
    done

    echo "Warning: PTP services still not fully active after retries."
    return 1
}

# 安装窗口先清理旧业务进程，避免升级后残留占用音频/GPIO/FIFO
stop_service_fast "$SERVICE_NAME" 6
stop_service_fast "$NETWORK_MONITOR_SERVICE" 4
force_cleanup_recording_processes

# --------------------------------------------------
# 0) 读取 DEVICE_SIDE
# --------------------------------------------------
DEVICE_SIDE=""

if [ -f /etc/environment ]; then
    DEVICE_SIDE=$(grep -E '^DEVICE_SIDE=' /etc/environment \
        | head -n1 \
        | cut -d= -f2- \
        | tr -d '"' \
        | xargs)
fi

if [ -z "$DEVICE_SIDE" ]; then
    echo "DEVICE_SIDE not set, skip network/PTP configuration"
else
    case "$(echo "$DEVICE_SIDE" | tr '[:upper:]' '[:lower:]')" in
        right)
            TARGET_IP="$IP_RIGHT"
            ;;
        left)
            TARGET_IP="$IP_LEFT"
            ;;
        *)
            echo "Unknown DEVICE_SIDE: $DEVICE_SIDE, skip configuration"
            TARGET_IP=""
            ;;
    esac
fi

# --------------------------------------------------
# 1) 配置 NetworkManager 静态 IP (使用 nmcli)
# --------------------------------------------------
if [ -n "$TARGET_IP" ]; then
    echo "Configuring NetworkManager for $INTERFACE_NAME ($DEVICE_SIDE → $TARGET_IP)"

    CONN_NAME="${INTERFACE_NAME}-{{APP_NAME}}"

    # 1. 如果连接已存在，先删除，确保配置干净
    if nmcli connection show "$CONN_NAME" >/dev/null 2>&1; then
        nmcli connection delete "$CONN_NAME"
    fi

    # 2. 添加新连接
    nmcli connection add \
        type ethernet \
        con-name "$CONN_NAME" \
        ifname "$INTERFACE_NAME" \
        ipv4.method manual \
        ipv4.addresses "${TARGET_IP}/24" \
        ipv6.method ignore

    # 3. 确保连接启动
    nmcli connection up "$CONN_NAME" || true
fi

# --------------------------------------------------
# 2) 配置 PTP 时间同步 (linuxptp)
# --------------------------------------------------
# 依赖: linuxptp (ptp4l, phc2sys)
# Right (Master): System Clock -> PHC (NIC) -> Network
# Left  (Slave) : Network -> PHC (NIC) -> System Clock
# --------------------------------------------------

if [ -n "$DEVICE_SIDE" ]; then
    # 确保配置目录存在
    mkdir -p "$PTP_CONF_DIR"

    # 停止旧的 PTP 服务以应用新配置
    systemctl stop ptp4l phc2sys 2>/dev/null || true

    case "$(echo "$DEVICE_SIDE" | tr '[:upper:]' '[:lower:]')" in
        left)
            echo "Configuring PTP for LEFT (Slave)..."

            # 1. 关闭普通网络授时 (NTP), 避免与 PTP 冲突
            timedatectl set-ntp false || true

            # 2. 生成 ptp4l 配置文件 (Slave Mode)
            # slaveOnly 1: 强制作为从钟
            cat <<EOPTPSLAVE > "$PTP_CONF_FILE"
[global]
tx_timestamp_timeout   50
slaveOnly              1
priority1              255
priority2              255
domainNumber           0
time_stamping          hardware
# 允许正常运行中超过 0.2秒则跳变
step_threshold         0.2
# 第一次同步时，只要误差超过 0.00002秒 (20us) 就立刻跳变，实现快速启动
first_step_threshold   0.0002
# 接口
[$INTERFACE_NAME]
EOPTPSLAVE

            # 3. 创建/重写 phc2sys 服务 (PHC -> System Clock)
            # -s $INTERFACE_NAME: 源是网卡时钟
            # -c CLOCK_REALTIME: 目标是系统时钟
            # -w: 等待 ptp4l 同步
            # 加入 -S 0.2 (Step threshold)
            cat <<EOPHCSLEFT > /etc/systemd/system/phc2sys.service
[Unit]
Description=Synchronize system clock or PTP hardware clock (PHC)
After=ptp4l.service
Requires=ptp4l.service

[Service]
Type=simple
ExecStart=/usr/sbin/phc2sys -s $INTERFACE_NAME -c CLOCK_REALTIME -w -O 0 -S 0.2
Restart=always

[Install]
WantedBy=multi-user.target
EOPHCSLEFT
            ;;

        right)
            echo "Configuring PTP for RIGHT (Master)..."

            # 1. 关闭普通网络授时 (NTP), 会使用单独的ntpservice做one shot逻辑，获取互联网时间作为基准
            timedatectl set-ntp false || true

            # 2. 生成 ptp4l 配置文件 (Master Mode)
            # priority1 10: 优先级高，确保成为 Master (默认是 128)
            cat <<EOPTMASTER > "$PTP_CONF_FILE"
[global]
tx_timestamp_timeout   50
priority1              10
priority2              10
domainNumber           0
time_stamping          hardware
[$INTERFACE_NAME]
EOPTMASTER

            # 3. 创建/重写 phc2sys 服务 (System Clock -> PHC)
            # -s CLOCK_REALTIME: 源是系统时钟 (由 NTP 维护)
            # -c $INTERFACE_NAME: 目标是网卡 PHC
            # -w: 等待 ptp4l
            cat <<EOPHCSRIGHT > /etc/systemd/system/phc2sys.service
[Unit]
Description=Synchronize system clock or PTP hardware clock (PHC)
After=ptp4l.service
Requires=ptp4l.service

[Service]
Type=simple
ExecStart=/usr/sbin/phc2sys -s CLOCK_REALTIME -c $INTERFACE_NAME -w -O 0 -S 1.0
Restart=always

[Install]
WantedBy=multi-user.target
EOPHCSRIGHT
            ;;
    esac

    # --------------------------------------------------
    # 通用 PTP 服务配置 (ptp4l)
    # --------------------------------------------------
    cat <<EOPTPUNIT > /etc/systemd/system/ptp4l.service
[Unit]
Description=Precision Time Protocol (PTP) service
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/ptp4l -f $PTP_CONF_FILE -i $INTERFACE_NAME
Restart=always

[Install]
WantedBy=multi-user.target
EOPTPUNIT

    systemctl daemon-reload
    restart_ptp_stack_with_retry || true
fi

# --------------------------------------------------
# 3) 配置应用服务权限及启动
# --------------------------------------------------
chmod +x "$NTP_SYNC_SCRIPT"
chmod +x "$MONITOR_SCRIPT"
chmod +x "$APP_DIR/run_record.sh"
chmod +x "$SHUTDOWN_TRIGGER_SCRIPT"
chmod -R 777 "$APP_DIR"

# 初始化持久化标定目录：仅首次缺失时写入默认 fake calibration
mkdir -p "$CALIB_PERSIST_DIR"
if [ ! -f "$CALIB_PERSIST_FILE" ] && [ -f "$APP_DIR/config/fakeCamCalib.json" ]; then
    cp -f "$APP_DIR/config/fakeCamCalib.json" "$CALIB_PERSIST_FILE"
fi

systemctl daemon-reload

udevadm control --reload-rules
# 仅重触发视频设备，应用相机相关 udev 规则；避免触发 block add 导致升级期间重复执行 usb-auto-update
udevadm trigger --subsystem-match=video4linux
# 不主动触发 block add，存储设备规则等待后续真实插拔事件生效

# NTP 同步服务（仅right启动）
if [ "$(echo "$DEVICE_SIDE" | tr '[:upper:]' '[:lower:]')" == "right" ]; then
    systemctl enable "$NTP_SYNC_SERVICE"
    # 不能重启，ntp服务不会立即返回，会有很长的超时，会导致安装卡住
fi

# PTP 监控服务
systemctl enable "$MONITOR_SERVICE"
systemctl restart "$MONITOR_SERVICE"

# 双键关机触发服务
# 安装阶段若残留触发文件，会导致 Path 单元立即触发关机流程。先清理。
rm -f /tmp/umi_shutdown_request
systemctl enable "$SHUTDOWN_TRIGGER_SERVICE" "$SHUTDOWN_TRIGGER_PATH"
if ! systemctl restart "$SHUTDOWN_TRIGGER_PATH"; then
    echo "Warning: failed to restart $SHUTDOWN_TRIGGER_PATH (will not block install)"
fi

# 主应用服务
systemctl enable "$SERVICE_NAME"
systemctl restart "$SERVICE_NAME"

# 网线监测服务最后启动，降低安装窗口内竞态
systemctl enable "$NETWORK_MONITOR_SERVICE"
systemctl restart "$NETWORK_MONITOR_SERVICE"

echo "[$SERVICE_NAME] Installed and Started successfully."
exit 0
