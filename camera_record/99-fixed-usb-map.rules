# ========================
# 1. 摄像头映射 (创建软链接)
# ========================
# 摄像头通常会生成两个节点(videoN, videoN+1)，我们通常只需要N
# ===== Right Camera (Bus1 Port4) =====
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="3-1.3", \
  ATTR{name}=="N160MU2: N160MU2", \
  ATTR{index}=="0", \
  SYMLINK+="right_tcam"

# ===== Left Camera (Bus3 Port2) =====
SUBSYSTEM=="video4linux", KERNEL=="video*", KERNELS=="3-1.2", \
  ATTR{name}=="N160MU2: N160MU2", \
  ATTR{index}=="0", \
  SYMLINK+="left_tcam"

# ====================== THIRD CAMERA ======================
# USB Camera3 (Realtek Semiconductor Corp.)
# Vendor ID: 0bda, Product ID: 5858
SUBSYSTEM=="video4linux", KERNEL=="video*", \
  ATTRS{idVendor}=="0bda", ATTRS{idProduct}=="5858", \
  ATTR{index}=="0", \
  SYMLINK+="third_cam"

# ====================== STEREO CAMERA =====================
# Sunplus Innovation / DECXIN Stereo Camera
# VID:PID = 1bcf:2d4f
# USB Port: 1-1
SUBSYSTEM=="video4linux", KERNEL=="video*", \
  KERNELS=="1-1", \
  ATTRS{idVendor}=="1bcf", ATTRS{idProduct}=="2d4f", \
  ATTR{index}=="0", \
  SYMLINK+="stereo_cam"

# ====================== FAYS FTDI CAMERA ==================
# Future Technology Devices International, Ltd FTDI Superspeed Video Bridge
# VID:PID = 0403:602e
# Interface 00: Stereo channel -> /dev/fays_stereo
# Interface 02: IMU channel    -> /dev/fays_imu
SUBSYSTEM=="video4linux", KERNEL=="video*", \
  ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="602e", \
  ENV{ID_USB_INTERFACE_NUM}=="00", ATTR{index}=="0", \
  SYMLINK+="fays_stereo"

SUBSYSTEM=="video4linux", KERNEL=="video*", \
  ENV{ID_VENDOR_ID}=="0403", ENV{ID_MODEL_ID}=="602e", \
  ENV{ID_USB_INTERFACE_NUM}=="02", ATTR{index}=="0", \
  SYMLINK+="fays_imu"

SUBSYSTEM=="video4linux", KERNEL=="video*", \
  ATTRS{idVendor}=="0403", ATTRS{idProduct}=="602e", \
  MODE="0777", GROUP="video"

SUBSYSTEM=="usb", \
  ATTR{idVendor}=="0403", ATTR{idProduct}=="602e", \
  MODE="0777", GROUP="plugdev"

# ========================
# 2. 存储设备映射 (U盘 / 硬盘)
# ========================
# 固定 USB 物理端口：4-1 USB3.0 / 3-1.1 USB2.0
ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", \
KERNELS=="4-1", ENV{ID_FS_USAGE}=="filesystem", \
RUN+="/bin/sh -c '/usr/bin/systemctl reset-failed mnt-data_disk.mount; /usr/bin/systemd-mount --no-block --collect -o uid=1000,gid=1000,noatime $devnode /mnt/data_disk'"

ACTION=="add", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", \
KERNELS=="3-1.1", ENV{ID_FS_USAGE}=="filesystem", \
RUN+="/bin/sh -c '/usr/bin/systemctl reset-failed mnt-data_disk.mount; /usr/bin/systemd-mount --no-block --collect -o uid=1000,gid=1000,noatime $devnode /mnt/data_disk'"
